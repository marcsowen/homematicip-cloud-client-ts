{
  "name": "homematicip-cloud-client-ts",
  "version": "0.2.0",
  "description": "Unofficial TypeScript and JavaScript client for the Homematic IP Cloud REST and WebSocket APIs",
  "license": "Apache-2.0",
  "author": "Marc Sowen <marc@sowen.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcsowen/homematicip-cloud-client-ts.git"
  },
  "bugs": {
    "url": "https://github.com/marcsowen/homematicip-cloud-client-ts/issues"
  },
  "keywords": [
    "homematicip",
    "homematic-ip",
    "hmip",
    "typescript",
    "javascript",
    "cloud",
    "rest",
    "websocket",
    "access-point"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "lint": "biome check src",
    "test": "pnpm run build && node --test test/*.test.js",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "pnpm run lint && pnpm run test"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "dependencies": {
    "p-queue": "^9.3.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
